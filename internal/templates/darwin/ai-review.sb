(version 1)
(deny default)
(allow process-exec (literal "{{.Program}}"))
(allow process-fork)
(allow file-read* (subpath "/System") (subpath "/usr/bin") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/Library") (subpath "/bin") (subpath "/sbin") (subpath "/private/etc") (subpath "/etc") (subpath "/dev"))
(allow file-read* (subpath "{{.RuntimeRoot}}") (subpath "{{.AIHome}}") (subpath "{{.ReviewDir}}") (literal "{{.ReviewPath}}"))
(allow file-write* (subpath "{{.AIHome}}"){{.TmpRule}} (literal "/dev/null"))
(allow network-outbound)
(allow mach-lookup)
(allow sysctl-read)
(allow file-read-metadata)
