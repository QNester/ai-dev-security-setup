[Unit]
Description=sandboxctl AI UID egress restrictions
After=network-pre.target nftables.service
Wants=network-pre.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{.NFTPath}} -f {{.NFTFile}}
ExecStop=-{{.NFTPath}} delete table inet ai_dev_isolation
ExecStop=-{{.NFTPath}} delete table ip ai_dev_isolation
ExecStop=-{{.NFTPath}} delete table ip6 ai_dev_isolation

[Install]
WantedBy=sysinit.target
