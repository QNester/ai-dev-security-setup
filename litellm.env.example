# Copy this file to litellm.env, then fill in the providers you use.
# Keep the copy out of Git (it is already ignored) and mode 600.
#
# The setup script only reads provider NAMES from this file to choose default
# model IDs. It never sources or executes it.
# start-litellm.sh sources it before starting the proxy.

# Key for the local LiteLLM gateway. Clients (including the sandbox) send this
# as "Authorization: Bearer ...". Use a long random value, e.g. sk-...
LITELLM_MASTER_KEY=

# Optional Postgres database for virtual keys, budgets and request logs.
# Required if you want a scoped virtual key instead of the master key.
# DATABASE_URL=postgresql://litellm:password@127.0.0.1:5432/litellm

# Provider keys. Fill in only the ones you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# Local Ollama endpoint. Uncomment and set if you use local models.
# OLLAMA_API_BASE=http://127.0.0.1:11434
